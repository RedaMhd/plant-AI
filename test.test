{
    "projectName": "plant AI",
    "totalEstimatedHours": 54,
    "tasks": [
        {
            "id": "TASK-001",
            "title": "Set Up the Project Environment and File Structure",
            "description": "Initialize the PLANIT AI project using HTML, CSS, JavaScript ES6 modules and Tailwind CSS. Create the required folders and files to separate pages, application logic, styles, data and resources. Configure a local development server so that ES6 modules and Fetch requests work correctly. Establish a consistent naming convention for files and modules.",
            "userStories": [
                "As a developer, I want a structured project environment so that I can implement and maintain the application efficiently."
            ],
            "acceptanceCriteria": [
                "The project contains index.html, new-project.html and project.html.",
                "The project contains organized js, css, data and resources folders.",
                "Tailwind CSS is available and working in the application.",
                "A local development server successfully serves all HTML pages and static resources.",
                "JavaScript modules can be loaded without file protocol or CORS errors."
            ],
            "priority": "Critical",
            "importance": "High",
            "size": "S",
            "estimatedTime": 3,
            "deadline": "Day 1",
            "status": "To Do",
            "dependencies": []
        },
        {
            "id": "TASK-002",
            "title": "Define the Application Architecture and Data Models",
            "description": "Define the responsibilities of the JavaScript modules before implementation. Plan the separation between DOM manipulation, application state, API communication, prompt construction, persistence and reusable utilities. Define the project and task data structures, including all required task properties and permitted values. Establish how project IDs, task IDs and navigation between pages will work.",
            "userStories": [
                "As a developer, I want a clearly defined application architecture so that each module has one responsibility and the code remains maintainable.",
                "As a user, I want my projects and tasks to follow a consistent data structure so that information is displayed and saved correctly."
            ],
            "acceptanceCriteria": [
                "The architecture defines separate responsibilities for main.js, ui.js, state.js, api.js, prompt.js, storage.js and utils.js.",
                "Each HTML page loads exactly one JavaScript entry point using a script element with type="module" and src="js/main.js".",
                "The project data model includes the project name, description, brief, duration, developer count, technologies, difficulty and tasks.",
                "The task data model includes all required fields: id, title, description, userStories, acceptanceCriteria, priority, importance, size, estimatedTime, deadline, status and dependencies.",
                "All allowed enum values are documented and consistently defined.",
                "The architecture does not rely on shared global variables or inline onclick attributes."
            ],
            "priority": "High",
            "importance": "High",
            "size": "S",
            "estimatedTime": 3,
            "deadline": "Day 1",
            "status": "To Do",
            "dependencies": [
                "TASK-001"
            ]
        },
        {
            "id": "TASK-003",
            "title": "Create the HTML Page Structures and Shared Layout",
            "description": "Build the initial structures of the Dashboard, New Project and Task Board pages. Implement a consistent application header containing the PLANIT AI logo, navigation links and access to AI settings. Create reusable visual patterns for page containers, sections, buttons and content areas using Tailwind CSS. Add the required module entry point to each page.",
            "userStories": [
                "As a user, I want consistent navigation across the application so that I can move easily between the Dashboard, project creation and Task Board.",
                "As a user, I want a clear and organized interface so that I can understand the application's main sections."
            ],
            "acceptanceCriteria": [
                "index.html, new-project.html and project.html contain their respective page structures.",
                "Each page displays the PLANIT AI header and the required navigation links.",
                "The AI settings access is available from the shared header.",
                "Navigation links open the correct HTML pages.",
                "Each page loads exactly one JavaScript module entry point.",
                "The shared layout uses Tailwind CSS classes and does not contain inline JavaScript event handlers."
            ],
            "priority": "High",
            "importance": "High",
            "size": "S",
            "estimatedTime": 3,
            "deadline": "Day 2",
            "status": "To Do",
            "dependencies": [
                "TASK-001",
                "TASK-002"
            ]
        },
        {
            "id": "TASK-004",
            "title": "Implement Application State, Storage and Utility Modules",
            "description": "Implement the foundation of the JavaScript application. Create state.js to manage projects and the currently selected project, storage.js to save and retrieve project data, and utils.js for reusable operations such as ID generation, progress calculation, numeric validation and deadline handling. Persist projects and their task modifications in localStorage so that application data remains available after page reloads. Keep AI credentials separate from persistent project data.",
            "userStories": [
                "As a user, I want my projects and task changes to remain available after refreshing the page so that I do not lose my work.",
                "As a developer, I want centralized state and utility functions so that different pages use the same application logic."
            ],
            "acceptanceCriteria": [
                "state.js exports named functions for reading and updating application state.",
                "storage.js exports named functions for saving, loading and deleting projects.",
                "Project data is successfully saved to and restored from localStorage.",
                "A unique project identifier is generated for each new project.",
                "Task IDs follow the required TASK-001, TASK-002 format within each project.",
                "The project progress calculation uses only the number of Done tasks divided by the total number of tasks.",
                "An empty task list does not cause a division-by-zero error.",
                "API credentials are not stored in localStorage."
            ],
            "priority": "Critical",
            "importance": "High",
            "size": "S",
            "estimatedTime": 3,
            "deadline": "Day 2",
            "status": "To Do",
            "dependencies": [
                "TASK-001",
                "TASK-002"
            ]
        },
        {
            "id": "TASK-005",
            "title": "Implement the AI Settings Modal and Session Storage",
            "description": "Create an accessible AI settings modal that can be opened from the application header. Add a password-type input for the API key and controls to save or update the key. Implement the settings logic in dedicated modules and store the key exclusively in sessionStorage. Ensure that the application can retrieve the key during the current browser session without displaying its value in plain text.",
            "userStories": [
                "As a user, I want to enter and manage my AI API key so that I can generate development plans using the AI service.",
                "As a user, I want my API key to be stored only for the current browser session so that it is not permanently saved with my project data."
            ],
            "acceptanceCriteria": [
                "The AI settings modal opens from the header on every application page.",
                "The API key field uses input type="password".",
                "The user can save and update the API key.",
                "The API key is stored and retrieved using sessionStorage.",
                "The API key is not written to localStorage.",
                "The key remains available after navigating between application pages in the same session.",
                "The modal can be closed without saving changes."
            ],
            "priority": "High",
            "importance": "High",
            "size": "S",
            "estimatedTime": 3,
            "deadline": "Day 3",
            "status": "To Do",
            "dependencies": [
                "TASK-003",
                "TASK-004"
            ]
        },
        {
            "id": "TASK-006",
            "title": "Implement the Dashboard and Project Management Interface",
            "description": "Implement the Dashboard using ui.js for all DOM manipulation. Retrieve saved projects from the application state and render them as project cards. Each card must display the project name, description, total tasks, completed tasks, remaining tasks and progress percentage with a visual progress bar. Add navigation to the selected project's Task Board and a delete action with a confirmation step. Implement the empty state with a clear message and a button to create the first project.",
            "userStories": [
                "As a user, I want to see all my projects and their progress on the Dashboard so that I can monitor my development work.",
                "As a user, I want to open a project's Task Board from its card so that I can manage its tasks.",
                "As a user, I want to delete an unwanted project after confirmation so that I can keep my workspace organized."
            ],
            "acceptanceCriteria": [
                "Saved projects are displayed as individual cards.",
                "Each card displays the project name, description and task statistics.",
                "Completed tasks are counted using the Done status only.",
                "Remaining tasks are calculated as total tasks minus completed tasks.",
                "The progress bar displays the correct Done-to-total percentage.",
                "The project card provides a working link to project.html with the correct project ID.",
                "Project deletion requires user confirmation.",
                "Deleting a project removes it from persistent storage and immediately updates the Dashboard.",
                "When no projects exist, the required empty-state message and New Project action are displayed."
            ],
            "priority": "High",
            "importance": "High",
            "size": "S",
            "estimatedTime": 3,
            "deadline": "Day 3",
