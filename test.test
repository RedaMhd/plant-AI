        {
            "id": "TASK-007",
            "title": "Build the New Project Form and Real-Time Validation",
            "description": "Implement the project creation form with fields for project name, description, complete brief, duration in days, number of developers, technologies and difficulty level. Add real-time validation using input and submit events, with regular expressions and numeric checks where appropriate. Display an individual error message below each invalid field and prevent submission until every required field is valid.",
            "userStories": [
                "As a user, I want to enter my project's requirements and constraints so that the application can generate a suitable development plan.",
                "As a user, I want immediate validation feedback so that I can correct form errors before generating my plan."
            ],
            "acceptanceCriteria": [
                "The form contains all seven required project information fields.",
                "The difficulty select offers Beginner, Intermediate and Advanced.",
                "The project name, description, brief, duration, developer count and technologies are validated as required fields.",
                "Duration and developer count accept integers greater than or equal to 1 only.",
                "Invalid values display an error message below their corresponding fields.",
                "Validation is triggered by input events and checked again on form submission.",
                "The submit button remains disabled while at least one field is invalid.",
                "The submit button becomes enabled when every field is valid.",
                "Invalid form data cannot trigger an API request."
            ],
            "priority": "Critical",
            "importance": "High",
            "size": "S",
            "estimatedTime": 3,
            "deadline": "Day 4",
            "status": "To Do",
            "dependencies": [
